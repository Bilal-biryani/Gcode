# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored, so passwords never get committed.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=gcode

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=gcode

# --- login and roles ---------------------------------------------------------
# Long random string used to sign the login cookie (required in production).
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: MySQL accounts created by db/migrations/003_roles.sql.
# If these are not set, every route just uses the MYSQL_* account above.
DB_VIEWER_USER=gcode_viewer_user
DB_VIEWER_PASSWORD=change-me-viewer
DB_ADMIN_USER=gcode_admin_user
DB_ADMIN_PASSWORD=change-me-admin
